{
  "name": "vibe-tv",
  "productName": "Vibe TV",
  "version": "1.0.1",
  "description": "Vibe TV: a clean desktop player for M3U / IPTV playlists",
  "main": "main.js",
  "author": "Vibe TV",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "node scripts/start.js",
    "test": "node test/run.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "44.10.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.vibetv.app",
    "productName": "Vibe TV",
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "src/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": [
          "m3u",
          "m3u8"
        ],
        "name": "M3U Playlist",
        "role": "Viewer"
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "category": "AudioVideo",
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ]
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0"
  }
}
