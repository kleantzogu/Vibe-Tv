{
  "name": "vibe-tv",
  "productName": "Vibe TV",
  "version": "1.1.0",
  "description": "Vibe TV: a clean desktop player for M3U / IPTV playlists",
  "keywords": [
    "iptv",
    "m3u",
    "m3u8",
    "iptv-player",
    "video-player",
    "hls",
    "mpeg-ts",
    "xtream-codes",
    "electron",
    "desktop-app"
  ],
  "main": "main.js",
  "author": "The Vibe TV contributors",
  "homepage": "https://github.com/kleantzogu/Vibe-Tv#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kleantzogu/Vibe-Tv.git"
  },
  "bugs": {
    "url": "https://github.com/kleantzogu/Vibe-Tv/issues"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "node scripts/start.js",
    "test": "node test/run.js",
    "dist": "electron-builder",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "electron": "44.10.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.vibetv.app",
    "productName": "Vibe TV",
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "src/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": [
          "m3u",
          "m3u8"
        ],
        "name": "M3U Playlist",
        "role": "Viewer"
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "artifactName": "Vibe-TV-${version}-${arch}-mac.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "category": "AudioVideo",
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "artifactName": "Vibe-TV-${version}-${arch}.${ext}"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "kleantzogu",
        "repo": "Vibe-Tv",
        "releaseType": "release"
      }
    ],
    "dmg": {
      "artifactName": "Vibe-TV-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "Vibe-TV-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "ffmpeg-static": "5.3.0"
  }
}
